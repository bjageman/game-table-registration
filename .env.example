# Copy this file to .env only if .env does not already exist.
# Keep actual credentials in .env, which is ignored by Git.
# Restart the API after changing .env.

# Required for Discord OAuth: Developer Portal -> your application -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Required by the moderator login's server membership/role checks.
# Developer Portal -> the SAME application -> Bot -> Token.
# The bot must be installed in the server configured below.
DISCORD_BOT_TOKEN=
# Discord -> User Settings -> Advanced -> enable Developer Mode.
# Right-click the server -> Copy Server ID.
DISCORD_GUILD_ID=
# Right-click your own Discord profile -> Copy User ID.
OWNER_DISCORD_ID=

# Required by the current setup check; used when publishing signup polls.
# Right-click the signup channel -> Copy Channel ID (in the server above).
DISCORD_CHANNEL_ID=

# Optional comma-separated role IDs with moderator access.
# The configured owner already has access without a moderator role.
MODERATOR_ROLE_IDS=

# Browser origin, with no trailing slash. Register this exact origin plus
# /api/auth/callback in Developer Portal -> OAuth2 -> Redirects.
# Direct local development; Compose overrides this default to localhost:8080.
# Set PUBLIC_URL explicitly when using a different host or HTTPS.
# PUBLIC_URL=http://localhost:5180

# Optional for direct development; defaults to a local SQLite database.
# Compose supplies its PostgreSQL connection automatically.
# DATABASE_URL=sqlite:///./local.db
# Local Compose PostgreSQL password.
POSTGRES_PASSWORD=local-development-only

# Headless development: bind Vite to the network and set the browser origin.
# DEV_HOST=0.0.0.0
# PUBLIC_URL=http://your-server-hostname:5180
