# Copy to .env if needed; restart the API after editing. Never commit credentials.
# Required OAuth credentials: Discord Developer Portal -> your application -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Required bot token: Discord Developer Portal -> same application -> Bot -> Token.
DISCORD_BOT_TOKEN=
# Optional legacy default server. New users select their server/channel in Settings.
# Enable Developer Mode, then right-click your server and copy its ID.
DISCORD_GUILD_ID=
# Optional legacy owner account for access to the default server.
OWNER_DISCORD_ID=
# Optional legacy default signup channel.
DISCORD_CHANNEL_ID=
# Optional comma-separated Discord role IDs with moderator access.
MODERATOR_ROLE_IDS=
# Register PUBLIC_URL + /api/auth/callback in Discord OAuth2 Redirects; omit the trailing slash.
# Uncomment and set PUBLIC_URL for a non-default browser origin.
# PUBLIC_URL=http://localhost:5180
# Optional direct-development database; defaults to SQLite (Compose uses PostgreSQL).
# DATABASE_URL=sqlite:///./local.db
# Local Compose PostgreSQL password.
POSTGRES_PASSWORD=local-development-only
# Optional headless development settings.
# DEV_HOST=0.0.0.0
# PUBLIC_URL=http://your-server-hostname:5180

# Additional Discord user IDs allowed to populate test signups (owner always allowed).
TEST_SIGNUP_USER_IDS=
