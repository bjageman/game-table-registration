# Keep actual credentials in .env, which is ignored by Git.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
OWNER_DISCORD_ID=
# Optional comma-separated role IDs with moderator access.
MODERATOR_ROLE_IDS=
# Direct local development; Compose overrides this default to localhost:8080.
# Set PUBLIC_URL explicitly when using a different host or HTTPS.
# PUBLIC_URL=http://localhost:5180
# DATABASE_URL=sqlite:///./local.db
POSTGRES_PASSWORD=local-development-only

# Headless development: bind Vite to the network and set the browser origin.
# DEV_HOST=0.0.0.0
# PUBLIC_URL=http://your-server-hostname:5180
