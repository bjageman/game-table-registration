# Copy to .env if needed; restart the API after editing. Never commit credentials.
# Required OAuth credentials: Discord Developer Portal -> your application -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Required bot token: Discord Developer Portal -> same application -> Bot -> Token.
DISCORD_BOT_TOKEN=
# General Information -> Public Key. Configure the production app's Interactions Endpoint URL:
# https://signups.brodin.rocks/api/discord/interactions
DISCORD_PUBLIC_KEY=
DISCORD_SIGNUP_MODE=custom
# Required: enable Developer Mode, then right-click your server and copy its ID.
DISCORD_GUILD_ID=
# Required owner account: enable Developer Mode, then copy your Discord user ID.
OWNER_DISCORD_ID=
# Required signup channel: enable Developer Mode, then right-click the channel and copy its ID.
DISCORD_CHANNEL_ID=
# Optional comma-separated Discord role IDs with moderator access.
MODERATOR_ROLE_IDS=
# Register PUBLIC_URL + /api/auth/callback in Discord OAuth2 Redirects; omit the trailing slash.
# Uncomment and set PUBLIC_URL for a non-default browser origin.
# PUBLIC_URL=http://localhost:5180
# Optional direct-development database; defaults to SQLite (Compose uses PostgreSQL).
# DATABASE_URL=sqlite:///./local.db
# Local Compose PostgreSQL password.
POSTGRES_PASSWORD=
# Optional headless development settings.
# DEV_HOST=0.0.0.0
# PUBLIC_URL=http://your-server-hostname:5180

# Hosted prod; keep Discord credentials separate from production for dev.
DEPLOY_ENV=prod
APP_ENV_FILE=.env.prod
SIGNUPS_HOST=signups.brodin.rocks
EMAIL=
